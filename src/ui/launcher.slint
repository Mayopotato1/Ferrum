
component QuietButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: label.preferred-width + 16px;
    height: 28px;
    border-radius: 6px;
    background: pointer.has-hover || focus.has-focus ? #ffffff0f : transparent;
    border-width: focus.has-focus ? 1px : 0px;
    border-color: #929eb6;
    accessible-role: button;
    accessible-label: text;
    forward-focus: focus;
    label := Text {
        text: root.text;
        color: pointer.has-hover || focus.has-focus ? #f3f4f7 : #b2b8c4;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
    }
    pointer := TouchArea { clicked => { root.clicked(); } }
}

export struct Row {
    id: string,
    title: string,
    detail: string,
    source: string,
    icon: image,
    kind: string,
    available: bool,
    completion: bool,
}

export component Launcher inherits Window {
    title: "Ferrum";
    no-frame: true;
    full-screen: false;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    width: min(730px, available-width);
    height: surface.height + 80px;
    in property <[Row]> rows;
    in-out property <int> selected: 0;
    in-out property <string> query;
    in property <string> status: "Indexing…";
    in property <string> shortcut;
    in property <string> error;
    in property <bool> pending: true;
    in property <bool> indexing: true;
    in property <bool> cached-results: false;
    in property <bool> alias-mode: false;
    in property <bool> animate-opening: true;
    in property <float> panel-background-opacity: 1.0;
    in-out property <bool> palette-visible: false;
    property <float> entrance-scale: animate-opening ? 1.06 : 1.0;
    in property <length> available-height: 700px;
    in property <length> available-width: 730px;
    private property <bool> expanded: query != "";
    private property <length> results-height: expanded ? min(rows.length > 0 ? rows.length * 58px + 16px : 76px, max(76px, available-height - 206px - error-height - update-height)) : 0px;
    private property <length> error-height: error == "" ? 0px : min(error-text.preferred-height + 20px, 108px);
    callback changed(string);
    callback activate(int);
    callback force-web();
    callback conceal();
    callback refresh();
    callback quit();
    callback settings();
    in-out property <string> pending-update;
    private property <string> update-tag;
    private property <length> update-height: update-tag == "" ? 0px : 40px;
    callback update-view(string);
    callback update-later(string);
    public function focus-search() { search.focus(); }
    public function complete-alias(value: string, cursor-byte: int) {
        root.query = value;
        search.focus();
        search.set-selection-offsets(cursor-byte, cursor-byte);
        root.changed(value);
    }
    public function prepare-opening() {
        root.palette-visible = false;
        root.selected = 0;
        if (root.query != "") {
            root.query = "";
            // Invalidate outstanding results through the ordinary search callback.
            root.changed("");
        }
    }
    public function start-opening() { root.update-tag = root.pending-update; root.pending-update = ""; root.palette-visible = true; }
    public function cancel-opening() { root.palette-visible = false; }
    states [ shown when root.palette-visible: {
        entrance-scale: 1.0;
        in { animate entrance-scale { duration: root.animate-opening ? 170ms : 0ms; easing: ease-out; } }
    } ]

    keys := FocusScope {
      key-pressed(event) => {
          if (event.text == Key.Escape) { root.conceal(); return accept; }
          return reject;
      }
      surface := Rectangle {
        x: 40px; y: 40px;
        width: parent.width - 80px;
        height: 82px + root.results-height + root.error-height + root.update-height + 44px;
        background: rgba(34,37,43,root.panel-background-opacity);
        border-radius: 16px;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 6px;
        transform-scale: root.entrance-scale;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // Only the background fill is translucent; text/icons and animation stay unchanged.
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: 80px;
            border-radius: 15px; background: #ffffff03;
        }
        Image {
            x: 23px; y: 29px; width: 24px; height: 24px;
            source: @image-url("icons/search.svg");
        }
        Text {
            x: 65px; y: 20px; width: parent.width - 88px - (root.indexing ? 68px : 0px); height: 42px;
            text: root.pending && root.query == "" ? "Search apps, games, and more…" : "Search anything…";
            visible: root.query == "";
            color: #b3bac7;
            font-size: 23px;
            vertical-alignment: center;
        }
        search := TextInput {
            x: 65px; y: 20px; width: parent.width - 88px - (root.indexing ? 68px : 0px); height: 42px;
            text <=> root.query;
            color: #f5f6f8;
            font-size: 23px;
            single-line: true;
            vertical-alignment: center;
            selection-background-color: #53647e;
            selection-foreground-color: #ffffff;
            accessible-label: "Search applications, games, files or website shortcuts";
            edited => { root.changed(self.text); }
            accepted => { if (!root.pending) { root.activate(root.selected); } }
            key-pressed(event) => {
                // Consume Shift+Enter here so TextInput never invokes accepted too.
                if (event.text == Key.Return && event.modifiers.shift) { root.force-web(); return accept; }
                if (event.text == Key.Escape) { root.conceal(); return accept; }
                if (event.text == Key.DownArrow) { root.selected = max(0, min(root.selected + 1, root.rows.length - 1)); return accept; }
                if (event.text == Key.UpArrow) { root.selected = max(root.selected - 1, 0); return accept; }
                if (event.text == Key.Tab && root.alias-mode) {
                    if (!root.pending) { root.activate(root.selected); }
                    return accept;
                }
                return reject;
            }
        }
        if root.indexing: Text {
            x: parent.width - 88px; y: 33px; height: 18px; width: 65px;
            text: root.cached-results ? "Refreshing..." : "Indexing…"; color: #b3bac7; font-size: 11px;
            vertical-alignment: center; horizontal-alignment: right;
        }
        if root.expanded: Rectangle {
            x: 18px; y: 82px; width: parent.width - 36px; height: 1px;
            background: #ffffff0d;
        }
        results := Flickable {
            y: 83px; height: root.results-height; width: parent.width;
            content-height: max(self.height, root.rows.length * 58px + 16px);
            content-width: self.width;
            content-y: -max(0px, min(root.selected * 58px + 65px - self.height, self.content-height - self.height));
            for row[i] in root.rows: Rectangle {
                visible: root.expanded;
                x: 10px; y: 7px + i * 58px; width: parent.width - 20px; height: 56px;
                border-radius: 9px;
                background: i == root.selected ? #3a424f : (hover.has-hover ? #ffffff06 : transparent);
                opacity: root.pending ? 0.65 : 1;
                Rectangle {
                    x: 12px; y: 10px; width: 36px; height: 36px;
                    background: #ffffff08; border-radius: 8px;
                    Image {
                        x: 3px; y: 3px; width: 30px; height: 30px;
                        source: row.icon.width > 0 ? row.icon :
                            row.kind == "game" ? @image-url("icons/game.svg") :
                            row.kind == "folder" ? @image-url("icons/folder.svg") :
                            row.kind == "file" ? @image-url("icons/file.svg") :
                            row.kind == "web" ? @image-url("icons/web.svg") : @image-url("icons/application.svg");
                        image-fit: contain;
                    }
                }
                Text {
                    x: 62px; y: 8px; width: parent.width - 182px; height: 22px;
                    text: row.title; color: row.available ? #f0f2f5 : #b4bac5;
                    font-size: 14px; font-weight: i == root.selected ? 600 : 400;
                    overflow: elide; vertical-alignment: center;
                }
                Text {
                    x: 62px; y: 30px; width: parent.width - 182px; height: 17px;
                    text: row.detail; color: #b0b8c6;
                    font-size: 11px; overflow: elide;
                }
                Text {
                    x: parent.width - 114px; y: 19px; width: 76px; height: 18px;
                    text: row.source; color: #bac2d0; font-size: 10px;
                    horizontal-alignment: right; vertical-alignment: center; overflow: elide;
                }
                Image {
                    x: parent.width - 28px; y: 21px; width: 14px; height: 14px;
                    source: @image-url("icons/enter.svg");
                    visible: i == root.selected && !root.pending;
                }
                hover := TouchArea { clicked => { root.selected = i; if (row.completion && !root.pending) { root.activate(i); } root.focus-search(); } }
            }
            if root.expanded && root.rows.length == 0: Text {
                x: 24px; y: 18px; width: parent.width - 48px; height: 38px;
                text: root.pending ? "Searching…" : root.alias-mode ? "No matching @ commands. Type @ to see all shortcuts." : "No matches. Try another name or an @ shortcut.";
                color: #b3bac7; font-size: 13px; vertical-alignment: center;
            }
        }
        Rectangle {
            x: 18px; y: 82px + root.results-height;
            width: parent.width - 36px; height: root.error-height; clip: true;
            error-text := Text {
                x: 6px; y: 9px; width: parent.width - 12px;
                text: root.error; color: #f0ada6; font-size: 12px; wrap: word-wrap;
            }
        }
        Rectangle {
            x: 18px; y: parent.height - 44px;
            width: parent.width - 36px; height: 1px; background: #ffffff0d;
        }
        if root.update-tag != "": Rectangle {
            x: 18px; y: parent.height - 44px - root.update-height;
            width: parent.width - 36px; height: root.update-height;
            Text { x: 6px; width: parent.width - 150px; height: parent.height; vertical-alignment: center; color: #c4ccd8; font-size: 11px; text: "Ferrum update available · " + root.update-tag; overflow: elide; }
            HorizontalLayout {
                x: parent.width - 145px; width: 145px; height: parent.height; alignment: end;
                QuietButton { text: "View update"; clicked => { root.update-view(root.update-tag); } }
                QuietButton { text: "Later"; clicked => { root.update-later(root.update-tag); root.update-tag = ""; root.focus-search(); } }
            }
        }
        Text {
            x: 24px; y: parent.height - 32px; height: 22px; width: max(40px, parent.width - 298px);
            text: root.shortcut; color: #aeb6c5; font-size: 11px;
            overflow: elide; vertical-alignment: center;
        }
        HorizontalLayout {
            x: parent.width - self.width - 17px; y: parent.height - 36px;
            width: 238px; height: 28px; spacing: 4px; alignment: end;
            QuietButton { text: "Refresh"; clicked => { root.refresh(); root.focus-search(); } }
            QuietButton { text: "Hide"; clicked => { root.conceal(); } }
            QuietButton { text: "Settings"; clicked => { root.settings(); } }
            QuietButton { text: "Exit"; clicked => { root.quit(); } }
        }
      }
    }
}
